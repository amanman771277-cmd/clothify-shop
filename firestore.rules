rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'pDS9I0dPdCOx8Eh5SVoWqqLK0V62' ||
        (
          request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email == 'amanuelyohannes929@gmail.com'
        )
      );
    }

    function isSeller() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller'
        )
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && url.size() < 1000 && (
        url.matches("^https://.*") ||
        url.matches("^http://.*") ||
        url.matches("^data:image/.*")
      );
    }

    function isValidImageUrlsList(urls) {
      return urls is list && urls.size() <= 10;
    }

    function isValidStringList(items) {
      return items is list && items.size() <= 20;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Entity Validators
    // ===============================================================
    function isValidProduct(data) {
      return hasOnlyAllowedFields([
               'name', 'description', 'price', 'originalPrice', 'category',
               'imageUrl', 'imageUrls', 'sizes', 'colors', 'createdAt',
               'sellerId', 'sellerName', 'isAvailable', 'status'
             ]) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 2000 &&
             data.price is number && data.price >= 0 &&
             (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0)) &&
             data.category is string && data.category.size() > 0 && data.category.size() < 50 &&
             isValidUrl(data.imageUrl) &&
             (!('imageUrls' in data) || isValidImageUrlsList(data.imageUrls)) &&
             (!('sizes' in data) || isValidStringList(data.sizes)) &&
             (!('colors' in data) || isValidStringList(data.colors)) &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() < 100)) &&
             (!('isAvailable' in data) || data.isAvailable is bool) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return hasOnlyAllowedFields(['productId', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'createdAt']) &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 100 &&
             (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() < 1000)) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    function isValidWishlistItem(data) {
      return hasOnlyAllowedFields(['userId', 'productId', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
             data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return hasOnlyAllowedFields([
               'buyerId', 'sellerId', 'productId', 'productName', 'price', 'quantity',
               'imageUrl', 'size', 'color', 'shippingDetails', 'total', 'status',
               'statusHistory', 'estimatedDelivery', 'paymentMethod', 'paymentStatus',
               'tx_ref', 'createdAt'
             ]) &&
             data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.price is number && data.price >= 0 &&
             (!('total' in data) || (data.total is number && data.total >= 0)) &&
             data.shippingDetails is map &&
             data.status is string && data.status in ['Processing', 'Shipped', 'Delivered'] &&
             (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50)) &&
             data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields([
               'uid', 'email', 'displayName', 'phoneNumber', 'photoURL', 'role',
               'createdAt', 'balance', 'bankInfo', 'telebirrNumber',
               'sellerVerified', 'sellerInfo'
             ]) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             data.role in ['user', 'seller', 'admin'] &&
             (!('balance' in data) || data.balance is number) &&
             (!('bankInfo' in data) || data.bankInfo is map) &&
             (!('telebirrNumber' in data) || (data.telebirrNumber is string && data.telebirrNumber.size() <= 50)) &&
             (!('sellerVerified' in data) || data.sellerVerified is bool) &&
             (!('sellerInfo' in data) || data.sellerInfo is map) &&
             data.createdAt is timestamp;
    }

    function isValidPayoutRequest(data) {
      return hasOnlyAllowedFields([
               'sellerId', 'sellerName', 'amount', 'status',
               'paymentMethod', 'paymentDetails', 'createdAt', 'processedAt'
             ]) &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.sellerName is string && data.sellerName.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.status is string && data.status in ['Pending', 'Paid', 'Rejected'] &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('paymentDetails' in data) || (data.paymentDetails is string && data.paymentDetails.size() <= 200)) &&
             data.createdAt is timestamp;
    }

    function isValidSellerApplication(data) {
      return hasOnlyAllowedFields([
               'userId', 'userEmail', 'fullName', 'firstName', 'fatherName',
               'grandfatherName', 'phoneNumber', 'idFrontUrl', 'idBackUrl',
               'status', 'rejectionReason', 'createdAt', 'processedAt'
             ]) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200)) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 50)) &&
             (!('fatherName' in data) || (data.fatherName is string && data.fatherName.size() <= 50)) &&
             (!('grandfatherName' in data) || (data.grandfatherName is string && data.grandfatherName.size() <= 50)) &&
             data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 50 &&
             isValidUrl(data.idFrontUrl) &&
             isValidUrl(data.idBackUrl) &&
             data.status is string && data.status in ['Pending', 'Approved', 'Rejected'] &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
             data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return hasOnlyAllowedFields(['userId', 'message', 'read', 'createdAt', 'type']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.message is string && data.message.size() > 0 && data.message.size() < 1000 &&
             data.read is bool &&
             data.type is string && data.type.size() <= 50 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /products/{productId} {
      allow read: if true;

      allow create: if isValidId(productId) &&
                    (isAdmin() || isSeller()) &&
                    hasRequiredFields(['name', 'description', 'price', 'category', 'imageUrl', 'sellerId', 'createdAt']) &&
                    isValidProduct(request.resource.data) &&
                    request.resource.data.sellerId == request.auth.uid;

      allow update: if isValidId(productId) &&
                    isValidProduct(request.resource.data) &&
                    (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
                    (!('sellerId' in resource.data) || request.resource.data.sellerId == resource.data.sellerId) &&
                    (
                      ((isAdmin() || isSeller()) && (isSuperAdmin() || resource.data.sellerId == request.auth.uid || !('sellerId' in resource.data))) ||
                      (
                        isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable', 'status']) &&
                        request.resource.data.isAvailable == false &&
                        request.resource.data.status == 'sold'
                      )
                    );

      allow delete: if isValidId(productId) && (isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid));
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isAuthenticated() && hasRequiredFields(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) && isValidReview(request.resource.data);
      allow update: if isValidId(reviewId) && isAuthenticated() && resource.data.userId == request.auth.uid && isValidReview(request.resource.data) && areImmutableFieldsUnchanged(['createdAt', 'productId', 'userId']);
      allow delete: if isValidId(reviewId) && isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /wishlist/{itemId} {
      allow get: if isValidId(itemId) && isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(itemId) && isAuthenticated() && hasRequiredFields(['userId', 'productId', 'createdAt']) && isValidWishlistItem(request.resource.data);
      allow delete: if isValidId(itemId) && isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        isSuperAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid)
      );
      allow create: if isValidId(orderId) &&
                    isAuthenticated() &&
                    hasRequiredFields(['buyerId', 'sellerId', 'productId', 'price', 'shippingDetails', 'status', 'createdAt']) &&
                    isValidOrder(request.resource.data) &&
                    request.resource.data.buyerId == request.auth.uid;
      allow update: if isValidId(orderId) &&
                    isValidOrder(request.resource.data) &&
                    areImmutableFieldsUnchanged(['buyerId', 'sellerId', 'productId', 'createdAt']) &&
                    (
                      isSuperAdmin() ||
                      (
                        isAuthenticated() &&
                        resource.data.buyerId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus']) &&
                        request.resource.data.paymentStatus in ['Pending', 'Paid', 'Failed']
                      ) ||
                      (
                        isSeller() &&
                        resource.data.sellerId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory']) &&
                        request.resource.data.status in ['Processing', 'Shipped', 'Delivered']
                      )
                    );
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) &&
                    isAuthenticated() &&
                    request.auth.uid == userId &&
                    isValidUser(request.resource.data) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.role == 'user' &&
                    !('balance' in request.resource.data) &&
                    !('sellerVerified' in request.resource.data) &&
                    !('sellerInfo' in request.resource.data);
      allow update: if isValidId(userId) &&
                    isValidUser(request.resource.data) &&
                    (
                      (isSuperAdmin() && areImmutableFieldsUnchanged(['uid', 'email', 'createdAt'])) ||
                      (
                        isAuthenticated() &&
                        request.auth.uid == userId &&
                        areImmutableFieldsUnchanged(['uid', 'email', 'createdAt', 'role', 'balance', 'sellerVerified', 'sellerInfo'])
                      )
                    );
    }

    match /payoutRequests/{requestId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.sellerId == request.auth.uid);
      allow create: if isValidId(requestId) &&
                    isSeller() &&
                    hasRequiredFields(['sellerId', 'sellerName', 'amount', 'status', 'createdAt']) &&
                    isValidPayoutRequest(request.resource.data) &&
                    request.resource.data.sellerId == request.auth.uid &&
                    request.resource.data.status == 'Pending';
      allow update: if isValidId(requestId) &&
                    isSuperAdmin() &&
                    isValidPayoutRequest(request.resource.data) &&
                    areImmutableFieldsUnchanged(['sellerId', 'amount', 'createdAt']);
      allow delete: if false;
    }

    match /sellerApplications/{appId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(appId) &&
                    isAuthenticated() &&
                    hasRequiredFields(['userId', 'fullName', 'phoneNumber', 'idFrontUrl', 'idBackUrl', 'status', 'createdAt']) &&
                    isValidSellerApplication(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'Pending';
      allow update: if isValidId(appId) &&
                    isSuperAdmin() &&
                    isValidSellerApplication(request.resource.data) &&
                    areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isValidId(appId) && isSuperAdmin();
    }

    match /adminStats/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(notificationId) &&
                    isAuthenticated() &&
                    isValidNotification(request.resource.data) &&
                    (
                      isSuperAdmin() ||
                      request.resource.data.userId == request.auth.uid ||
                      request.resource.data.type == 'new_sale'
                    );
      allow update: if isValidId(notificationId) &&
                    isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    isValidNotification(request.resource.data) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
